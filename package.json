{
  "name": "fud-ai",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix web/app",
    "dev:all": "npm run dev:all --prefix web",
    "build": "npm run build:local --prefix web/app",
    "build:cloud": "npm run build:cloud --prefix web/app",
    "build:release": "npm run build:release --prefix web/app",
    "verify:deploy": "node web/scripts/verify-deploy-context.mjs",
    "test:staging": "npm run test:staging --prefix web",
    "preview": "npm run preview --prefix web/app",
    "lint": "npm run lint --prefix web/app",
    "test": "npm run test:web && npm run test:api && npm run test:mobile",
    "test:web": "npm run test --prefix web/app",
    "test:api": "npm run test:api --prefix web",
    "test:mobile": "npm run test --prefix mobile",
    "typecheck:api": "npm run typecheck:api --prefix web",
    "typecheck:mobile": "npm run typecheck --prefix mobile",
    "security:scan": "node scripts/security-scan.mjs",
    "security:scan:test": "node --test scripts/security-scan.test.mjs",
    "release:check": "node scripts/release-readiness.mjs",
    "release:check:structure": "node scripts/release-readiness.mjs --structure-only",
    "release:bundle": "node scripts/release-bundle.mjs",
    "release:check:test": "node --test scripts/release-readiness.test.mjs scripts/release-bundle.test.mjs",
    "support:check": "node scripts/support-resource-check.mjs",
    "copy-policy": "node --test scripts/copy-policy.test.mjs",
    "test:e2e": "npm run test:e2e --prefix web/app",
    "ci": "npm run security:scan:test && npm run security:scan && npm run copy-policy && npm run release:check:test && npm run release:check:structure && npm run release:bundle && npm run support:check && npm run verify:deploy && npm run ci --prefix web/app && npm run test:api && npm run typecheck:api && npm run test:staging && npm run typecheck:mobile && npm run test:mobile"
  }
}
