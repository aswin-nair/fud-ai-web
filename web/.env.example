# Server-side (Vercel + Neon) — do NOT commit real values
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=generate-a-random-string-at-least-32-characters-long
RATE_LIMIT_SECRET=generate-a-different-random-string-at-least-32-characters-long
ENABLE_CLOUD_WRITES=true
# Additive entity projection and local-to-cloud upload stay off for the first beta.
# ENABLE_ENTITY_PROJECTION=false
# ENABLE_LOCAL_MIGRATION=false
# ENABLE_MOBILE_AUTH=false

# Same Google client ID used by API to verify tokens
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Optional release identifier returned by /api/health and /api/ready
# RELEASE_ID=

# Staging lifecycle (`npm run test:staging`) — leave unset to skip without a fake pass
# STAGING_BASE_URL=https://your-staging.vercel.app

# Password recovery mail. All three are required before mail is sent.
# APP_ORIGIN=https://your-project.vercel.app
# MAIL_FROM=Fud AI <reset@your-domain>
# RESEND_API_KEY=
