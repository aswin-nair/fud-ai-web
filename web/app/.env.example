# Google OAuth Client ID (Web application)
# Create at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Required. Must be "local" (browser only) or "neon" (Vercel API + Neon).
# A missing value is a configuration error; the app will not default to local.
VITE_DATA_BACKEND=local

# Optional identifier baked into cloud and release builds
# VITE_RELEASE_ID=

# Optional — only if API is on a different origin
# VITE_API_URL=https://your-domain.com
